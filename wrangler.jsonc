{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vite-react-shadcn-ts",
	"main": "worker/index.ts",
	"account_id": "6f5438dfd233062d3f5fabdc86c9b592",
	"compatibility_date": "2026-08-10",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "*/*",
			"zone_name": "storeblink.com"
		}
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"vars": {
		"STOREFRONT_SEO_ENDPOINT": "https://shflnrznleodviqphvfg.supabase.co/functions/v1/storefront-seo",
		"SEO_ORCHESTRATOR_ENDPOINT": "https://shflnrznleodviqphvfg.supabase.co/functions/v1/domain-orchestrator"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"ratelimits": [
		{
			"name": "SEO_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"r2_buckets": [
		{
			"binding": "SEO_ARTIFACTS",
			"bucket_name": "storeblink-seo"
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	]
}