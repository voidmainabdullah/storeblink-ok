VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
VITE_TURNSTILE_SITE_KEY=your-production-turnstile-site-key
VITE_PLATFORM_HOSTS=storeblink.com

# Supabase Edge Function and deployment secrets. Configure these in the
# provider secret stores; never expose them as VITE_ variables or commit values.
APP_ALLOWED_ORIGINS=https://storeblink.com
CUSTOM_HOSTNAME_CNAME_TARGET=domains.storeblink.com
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-for-saas-token
DOMAIN_CRON_SECRET=generate-a-long-random-secret
HOSTINGER_API_TOKEN=your-hostinger-api-token
HOSTINGER_INCLUDED_DOMAIN_CLAIM_ENABLED=false
HOSTINGER_PAID_DOMAIN_PURCHASE_ENABLED=false
HOSTINGER_INCLUDED_TRANSFER_ENABLED=false

# Google Search Console automation. Create one OAuth Web client. The encryption
# key must be 32 random bytes encoded as base64url and stored server-side only.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://storeblink.com/domain/connect/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=your-32-byte-base64url-key
GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=1
# Set both previous values only during a controlled key rotation. Remove them
# after all durable ciphertext rows report the current key version.
# GOOGLE_TOKEN_ENCRYPTION_PREVIOUS_KEY=your-previous-32-byte-base64url-key
# GOOGLE_TOKEN_ENCRYPTION_PREVIOUS_KEY_VERSION=1
GOOGLE_STOREFRONT_META_INJECTION_ENABLED=false

# Adaptive Commerce trusted rollout boundary. The worker secret must contain
# the same random value in Supabase and Cloudflare; keep the service-role key
# only in the trusted Worker secret store. Supabase Vault must also contain
# `adaptive_rollout_edge_url` (the deployed evaluate-adaptive-rollouts URL) and
# `adaptive_rollout_cron_secret` (the same value as the Edge secret below).
ADAPTIVE_ROLLOUT_CRON_SECRET=generate-a-long-random-rollout-cron-secret
ADAPTIVE_ROLLOUT_WORKER_URL=https://storeblink.com/.storeblink/internal/adaptive-rollouts/evaluate
ADAPTIVE_ROLLOUT_WORKER_SECRET=generate-a-long-random-rollout-worker-secret
ADAPTIVE_ROLLOUT_WINDOW_MINUTES=15
ADAPTIVE_ROLLOUT_BATCH_LIMIT=100
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Worker and SEO deployment configuration.
STOREFRONT_SEO_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/storefront-seo
SEO_ORCHESTRATOR_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/domain-orchestrator
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production
SEO_SMOKE_SITEMAP_URL=https://your-store-domain.example/sitemap.xml
